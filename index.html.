let leaderboard = [];

try {
  leaderboard = JSON.parse(
    localStorage.getItem("wheelieLeaderboard") || "[]"
  );

  if (!Array.isArray(leaderboard)) leaderboard = [];
} catch (e) {
  leaderboard = [];
}

function renderLeaderboard() {
  const rows = $("leaderRows");

  rows.innerHTML = "";

  const scores = [...leaderboard]
    .sort((a, b) => b.score - a.score)
    .slice(0, 5);

  if (scores.length === 0) {
    rows.innerHTML =
      '<div class="leader-row"><span>No scores yet</span><b>---</b></div>';
    return;
  }

  scores.forEach((entry, index) => {
    const row = document.createElement("div");
    row.className = "leader-row";

    const name = document.createElement("span");
    name.textContent = (index + 1) + ". " + entry.name;

    const score = document.createElement("b");
    score.textContent = Math.floor(entry.score).toLocaleString();

    row.appendChild(name);
    row.appendChild(score);
    rows.appendChild(row);
  });
}

function saveLeaderboardScore() {
  const finalScore = Math.floor(game.score);

  if (finalScore <= 0) return;

  leaderboard.push({
    name: bikes[bikeType].name,
    score: finalScore
  });

  leaderboard.sort((a, b) => b.score - a.score);
  leaderboard = leaderboard.slice(0, 5);

  try {
    localStorage.setItem(
      "wheelieLeaderboard",
      JSON.stringify(leaderboard)
    );
  } catch (e) {}

  renderLeaderboard();
}

